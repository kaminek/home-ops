{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "matchPackagePatterns": ["kopia"],
      "allowedVersions": "<999"
    },
    {
      "matchDatasources": ["docker"],
      "matchPackagePatterns": ["postgresql"],
      "allowedVersions": "<17"
    },
    {
      // match the gateway-api cilium is built against (go.mod), bump with cilium
      "matchPackageNames": ["gateway-api", "kubernetes-sigs/gateway-api"],
      "allowedVersions": "<1.7.0"
    }
  ]
}
